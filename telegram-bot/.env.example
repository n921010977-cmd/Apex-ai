# ─── Telegram ───────────────────────────────────────────────────────────────
BOT_TOKEN=                      # from @BotFather
BOT_MODE=polling                # polling | webhook
WEBHOOK_DOMAIN=                 # https://bot.vertlix.ai  (webhook mode only)
WEBHOOK_PATH=/tg/webhook
PORT=8080

# ─── Database (same Postgres as the Vertlix app / Supabase) ──────────────────
DATABASE_URL=                   # postgresql://...:6543/postgres?pgbouncer=true  (pooled)
DIRECT_URL=                     # postgresql://...:5432/postgres                 (migrations)

# ─── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                 # optional — enables the OpenAI branch of the router
DEFAULT_MODEL=claude-haiku-4-5-20251001

# ─── Cache / rate-limit (optional; falls back to in-memory) ──────────────────
REDIS_URL=                      # redis://... or rediss://...  (Upstash works)

# ─── Email linking (reuses Vertlix Resend) ───────────────────────────────────
RESEND_API_KEY=
RESEND_FROM=Vertlix AI <onboarding@resend.dev>

# ─── Security ─────────────────────────────────────────────────────────────────
ADMIN_TELEGRAM_IDS=             # comma-separated numeric Telegram user ids
BOT_SECRET=                     # random string; used to sign link codes / callbacks
