# ─────────────────────────────────────────────────────────────
# Apex AI — переменные окружения
# Скопируй в .env.local и заполни. НЕ коммить .env.local!
# ─────────────────────────────────────────────────────────────

# ── NextAuth (обязательно) ──
# Секрет для подписи сессий. Сгенерируй: openssl rand -base64 32
NEXTAUTH_SECRET=
# Полный HTTPS-URL приложения. Локально — http://localhost:3000.
# На проде укажи собственный домен целиком со схемой: https://vertlix.ai
# (обязательно для корректных OAuth-редиректов и Secure-cookies).
NEXTAUTH_URL=http://localhost:3000

# Канонический домен без www и без схемы (напр. vertlix.ai). Если задан,
# www.<домен> будет 301-редиректиться на голый домен. Оставь пустым, если
# каноникализацию делаешь в панели Vercel (Settings → Domains).
SITE_DOMAIN=

# ── Шифрование чувствительных данных (опционально, рекомендуется на проде) ──
# Ключ AES-256 для шифрования полей at-rest (OAuth-токены, 2FA-секреты, API-ключи).
# Ровно 32 байта. Сгенерируй: openssl rand -base64 32
# Без него encryptIfConfigured() возвращает значение как есть (шифрование выкл.).
DATA_ENCRYPTION_KEY=

# ── PostHog (опционально — продуктовая аналитика: события, воронки, удержание) ──
# Project API Key и host из PostHog → Project Settings.
# Без ключа аналитика полностью выключена (no-op), приложение работает как обычно.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Anthropic / Claude (основной AI-провайдер) ──
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Google Gemini (запасной AI-провайдер) ──
# Используется, когда ANTHROPIC_API_KEY не задан — так AI работает при наличии
# любого одного ключа. Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель по умолчанию — gemini-2.5-flash; переопределить можно здесь.
GEMINI_MODEL=

# ── Supabase (обязательно для БД, авторизации, сохранения данных) ──
# Проект: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OAuth-провайдеры (опционально — вход через Google/GitHub) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI (опционально — эмбеддинги для памяти/RAG + модель GPT в чате) ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (опционально — модель Gemini в чате) ──
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ── xAI Grok (опционально — модель Grok в чате) ──
# https://console.x.ai
XAI_API_KEY=

# ── Brave Search (опционально — веб-поиск для агентов) ──
# https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# ── Stripe (опционально — оплата и тарифы) ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email / SMTP (опционально — уведомления, сброс пароля) ──
# Напр. Resend: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=noreply@vertlix.ai
