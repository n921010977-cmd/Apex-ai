# ─────────────────────────────────────────────────────────────
# Apex AI — переменные окружения
# Скопируй в .env.local и заполни. НЕ коммить .env.local!
# ─────────────────────────────────────────────────────────────

# ── NextAuth (обязательно) ──
# Секрет для подписи сессий. Сгенерируй: openssl rand -base64 32
NEXTAUTH_SECRET=
# Полный HTTPS-URL приложения. Локально — http://localhost:3000.
# На проде укажи собственный домен целиком со схемой: https://vertlix.ai
# (обязательно для корректных OAuth-редиректов и Secure-cookies).
NEXTAUTH_URL=http://localhost:3000

# Канонический домен без www и без схемы (напр. vertlix.ai). Если задан,
# www.<домен> будет 301-редиректиться на голый домен. Оставь пустым, если
# каноникализацию делаешь в панели Vercel (Settings → Domains).
SITE_DOMAIN=

# ── Шифрование чувствительных данных (опционально, рекомендуется на проде) ──
# Ключ AES-256 для шифрования полей at-rest (OAuth-токены, 2FA-секреты, API-ключи).
# Ровно 32 байта. Сгенерируй: openssl rand -base64 32
# Без него encryptIfConfigured() возвращает значение как есть (шифрование выкл.).
DATA_ENCRYPTION_KEY=

# ── PostHog (опционально — продуктовая аналитика: события, воронки, удержание) ──
# Project API Key и host из PostHog → Project Settings.
# Без ключа аналитика полностью выключена (no-op), приложение работает как обычно.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Anthropic / Claude (основной AI-провайдер) ──
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Google Gemini (второй AI-провайдер в очереди) ──
# Используется, когда Anthropic не настроен или не может ответить (нет средств,
# квота, сбой). Получить: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Модель по умолчанию — gemini-2.5-flash; переопределить можно здесь.
GEMINI_MODEL=

# ── Supabase (обязательно для БД, авторизации, сохранения данных) ──
# Проект: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OAuth-провайдеры (опционально — вход через Google/GitHub) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI (опционально — эмбеддинги для памяти/RAG + модель GPT в чате) ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (опционально — модель Gemini в чате) ──
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ── xAI Grok (третий AI-провайдер в очереди) ──
# Используется, когда не ответили ни Anthropic, ни Gemini. https://console.x.ai
GROK_API_KEY=
# Историческое имя той же переменной — поддерживается для совместимости.
XAI_API_KEY=
# Модель по умолчанию — grok-3-mini; переопределить можно здесь.
GROK_MODEL=

# ── Brave Search (опционально — свежие данные с рынка) ──
# Включает опцию «Свежие данные» в питч-деке и анализе: перед генерацией
# подтягиваются актуальные цифры по рынку и конкурентам. Без ключа опция просто
# ничего не добавляет. https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# ── Stripe (опционально — оплата и тарифы) ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email / SMTP (опционально — уведомления, сброс пароля) ──
# Напр. Resend: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=noreply@vertlix.ai

# ── Экономия на AI (необязательно) ──
# Модель для чата/агентов и для тяжёлых сценариев. По умолчанию обе — самая
# дешёвая Haiku. Для качества можно поставить ANTHROPIC_MODEL_HEAVY=claude-sonnet-5.
ANTHROPIC_MODEL_FAST=
ANTHROPIC_MODEL_HEAVY=
# Потолки вывода в токенах (чем меньше — тем дешевле запрос).
AI_MAX_TOKENS_CHAT=
AI_MAX_TOKENS_HEAVY=
AI_MAX_TOKENS_SHORT=

# ── Гостевой вход (без регистрации) ──
# По умолчанию включён: на /login есть кнопка «Войти без регистрации».
# Выключить: ALLOW_GUEST_ACCESS=false. Гостевой вход открыт всему интернету,
# а за каждым AI-запросом стоят деньги.
ALLOW_GUEST_ACCESS=

# ─── Крипто-оплата (OxaPay → вывод на Trust Wallet) ──────────────────────────
# Merchant API key из кабинета oxapay.com (им же OxaPay подписывает webhook).
# Адрес вывода (Trust Wallet USDT) настраивается ТАМ ЖЕ в кабинете, в коде его нет.
OXAPAY_MERCHANT_KEY=
# Базовый URL сайта для callback/return (напр. https://vertlixai.com)
NEXT_PUBLIC_APP_URL=
# Опционально: для durable-счётчиков лимитов и оплаченных тарифов на проде
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
