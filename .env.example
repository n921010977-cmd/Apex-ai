# ─────────────────────────────────────────────────────────────
# Apex AI — переменные окружения
# Скопируй в .env.local и заполни. НЕ коммить .env.local!
# ─────────────────────────────────────────────────────────────

# ── NextAuth (обязательно) ──
# Секрет для подписи сессий. Сгенерируй: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL приложения (на проде — адрес деплоя, напр. https://apex.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# ── Anthropic / Claude (обязательно для AI-функций) ──
# Ключ: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ── Supabase (обязательно для БД, авторизации, сохранения данных) ──
# Проект: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── OAuth-провайдеры (опционально — вход через Google/GitHub) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── OpenAI (опционально — эмбеддинги для памяти/RAG + модель GPT в чате) ──
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ── Google Gemini (опционально — модель Gemini в чате) ──
# https://aistudio.google.com/apikey
GOOGLE_AI_API_KEY=

# ── xAI Grok (опционально — модель Grok в чате) ──
# https://console.x.ai
XAI_API_KEY=

# ── Brave Search (опционально — веб-поиск для агентов) ──
# https://brave.com/search/api
BRAVE_SEARCH_API_KEY=

# ── Stripe (опционально — оплата и тарифы) ──
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email / SMTP (опционально — уведомления, сброс пароля) ──
# Напр. Resend: https://resend.com/api-keys
RESEND_API_KEY=
EMAIL_FROM=noreply@apex.ai
